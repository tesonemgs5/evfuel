{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sincronizza automatico",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/.vscode/sync-auto.ps1\"",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": true
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}